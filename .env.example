# Frontend (Quasar) → max-tune-engine
#
# Local: Vite proxies /engine → http://127.0.0.1:8000 (php artisan serve)
# When Herd is healthy again you can set:
# VITE_ENGINE_URL=https://max-tune-engine.test/api
#
# Production / Coolify *build* args (Vite inlines these at build time):
#   VITE_APP_MODE=production
# Staging/production ignore VITE_ENGINE_* — hosts come from apiConfig.js
# (maxtune-engine.mxlab.site). Leave Coolify VITE_ENGINE_* unset or set to
# mxlab; never use maxtune-engine.ictskills.center (proxy 404, no CORS).
# After changing build args or this repo, rebuild/redeploy the SPA.

VITE_APP_MODE=local
# Engine APP_MODE: personal | invite | public (see max-tune-engine .env)
